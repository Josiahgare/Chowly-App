PORT=3001

# ── Option A: single connection string (recommended for Render / hosted DBs) ──
# When DATABASE_URL is set, it takes precedence over the discrete vars below.
# SSL is enabled automatically in production; force it locally with PGSSL=true.
DATABASE_URL=your_postgresql_connection_string

# ── Option B: discrete connection vars (handy for local development) ──
# Used only when DATABASE_URL is NOT set.
DB_HOST=localhost
DB_PORT=5433
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_database_name

# Optional: force SSL on/off regardless of environment (true/false)
# PGSSL=true
